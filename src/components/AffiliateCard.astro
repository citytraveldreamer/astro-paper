---
// src/components/AffiliateCard.astro
const { title, description, link, buttonText, type } = Astro.props;

// 根據 type 顯示不同的 Icon (Klook 或 Agoda)
const isKlook = type === 'klook';
---

<div class="my-8 flex flex-col sm:flex-row items-center border border-border bg-muted/30 rounded-lg p-5 hover:border-accent transition-colors duration-300">
  <div class="flex-1">
    <h4 class="text-foreground font-bold mt-0 mb-2">{title}</h4>
    <p class="text-muted-foreground text-sm mb-0 sm:mb-0">
      {description}
    </p>
  </div>
  <div class="mt-4 sm:mt-0 sm:ml-6 w-full sm:w-auto">
    <a 
      href={link} 
      target="_blank" 
      rel="noopener noreferrer"
      class="block w-full text-center bg-accent text-accent-foreground px-6 py-2.5 rounded hover:opacity-90 transition-opacity font-medium no-underline"
    >
      {buttonText}
    </a>
  </div>
</div>
